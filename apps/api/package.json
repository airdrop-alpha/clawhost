{
    "name": "api",
    "version": "0.0.34",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -p 2222",
        "build": "next build",
        "start": "next start -p 2222",
        "test": "node --import tsx --test src/**/*.test.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check": "pnpm typecheck && pnpm lint",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "email:dev": "pnpm exec react-email dev -p 3333 --dir src/emails"
    },
    "dependencies": {
        "@hono/node-server": "^1.13.0",
        "@neondatabase/serverless": "^0.10.0",
        "@openclaw/i18n": "workspace:*",
        "@openclaw/shared": "workspace:*",
        "@polar-sh/sdk": "^0.42.5",
        "@react-email/components": "^1.0.6",
        "@react-email/preview-server": "^5.2.7",
        "cloudflare": "^5.2.0",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.36.0",
        "firebase-admin": "^13.0.0",
        "hono": "^4.6.0",
        "next": "^15.5.12",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "resend": "^6.9.1",
        "ssh2": "^1.17.0"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/ssh2": "^1.15.5",
        "drizzle-kit": "^0.28.0",
        "react-email": "^3.0.7",
        "tsx": "^4.19.0",
        "typescript": "^5.6.3"
    }
}
